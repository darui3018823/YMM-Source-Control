<Application x:Class="YmmSourceControl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="MutedForeground" Color="#858585" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F48771" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </Application.Resources>
</Application>

