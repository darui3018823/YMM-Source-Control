<UserControl x:Class="YmmSourceControl.Plugin.SourceControlToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             Background="#FFFFFF"
             Foreground="#333333">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F2F6FA" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.3*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.1*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="ソース管理" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="📁" ToolTip="リポジトリを選択" Click="ChooseRepositoryClick" />
        <Button Content="⟳" ToolTip="更新" Click="RefreshClick" Margin="0" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="⑂" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,7,0" />
      <TextBlock Grid.Column="1" Text="{Binding Branch}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding RepositoryState}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding RepositoryRoot}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />

    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FFFFFF" Margin="0,0,0,6">
      <TextBox x:Name="CommitMessage" Height="52" BorderThickness="0" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource ForegroundBrush}" ToolTip="コミットメッセージ" />
    </Border>
    <Grid Grid.Row="4" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Button Content="✓  コミット" Click="CommitClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" />
      <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid Grid.Row="5" Margin="0,2,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="変更" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{Binding Changes.Count}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
    <ListBox Grid.Row="6" x:Name="ChangesList" ItemsSource="{Binding Changes}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="23" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button Content="↶" Tag="{Binding}" ToolTip="変更を破棄" Click="DiscardClick" Margin="0,0,3,0" />
              <Button Content="+" Tag="{Binding}" ToolTip="ステージ" Click="StageClick" Margin="0" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="7" Margin="0,8,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="ステージ済みの変更" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{Binding Staged.Count}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
    <ListBox Grid.Row="8" x:Name="StagedList" ItemsSource="{Binding Staged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="23" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLabel}" Foreground="#3A8F3A" FontFamily="Consolas" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="−" Tag="{Binding}" ToolTip="ステージから外す" Click="UnstageClick" Margin="4,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="9" Margin="0,8,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="グラフ" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="履歴" Foreground="{StaticResource MutedBrush}" />
    </Grid>
    <ListBox Grid.Row="10" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Center" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
