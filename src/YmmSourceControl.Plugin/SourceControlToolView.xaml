<UserControl x:Class="YmmSourceControl.Plugin.SourceControlToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             Background="#1E1E1E">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#858585" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F48771" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="#2D2D2D" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="110" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="SOURCE CONTROL" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="📁" ToolTip="Choose repository" Click="ChooseRepositoryClick" />
        <Button Content="⟳" ToolTip="Refresh" Click="RefreshClick" Margin="0" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="⑂" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,7,0" />
      <TextBlock Grid.Column="1" Text="{Binding Branch}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding RepositoryState}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding RepositoryRoot}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
    <TextBox Grid.Row="3" x:Name="CommitMessage" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#252526" Foreground="{StaticResource ForegroundBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="6" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,8">
      <Button Content="✓  Commit" Click="CommitClick" Background="#264F78" />
      <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <Grid Grid.Row="5" Margin="0,5,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="CHANGES" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{Binding Changes.Count}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
    <ListBox Grid.Row="6" x:Name="ChangesList" ItemsSource="{Binding Changes}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="+" Tag="{Binding}" Click="StageClick" Margin="4,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="7" Margin="0,8,0,3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="STAGED CHANGES" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Text="{Binding Staged.Count}" Foreground="{StaticResource MutedBrush}" />
    </Grid>
    <ListBox Grid.Row="8" x:Name="StagedList" ItemsSource="{Binding Staged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusLabel}" Foreground="#89D185" FontFamily="Consolas" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Content="−" Tag="{Binding}" Click="UnstageClick" Margin="4,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>

