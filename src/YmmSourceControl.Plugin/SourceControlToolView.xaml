<UserControl x:Class="YmmSourceControl.Plugin.SourceControlToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220"
             Background="#FFFFFF"
             Foreground="#333333">
  <UserControl.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F2F6FA" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
      <Setter Property="ToolTipService.ShowDuration" Value="6000" />
      <Setter Property="ToolTipService.BetweenShowDelay" Value="100" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EAF2FA" />
          <Setter Property="BorderBrush" Value="#AFC8E0" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F2F6FA" />
          <Setter Property="BorderBrush" Value="#D7D7D7" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#F2F6FA" />
          <Setter Property="BorderBrush" Value="#D7D7D7" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="ソース管理" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="📁" ToolTip="リポジトリを選択" Click="ChooseRepositoryClick" />
        <Button Content="⟳" ToolTip="更新" Click="RefreshClick" />
        <Button Content="…" ToolTip="Git操作" Click="OpenRepositoryMenuClick" Margin="0">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Fetch" Click="FetchClick" />
              <MenuItem Header="Pull..." Click="PullClick" />
              <MenuItem Header="Push" Click="PushClick" />
              <MenuItem Header="同期" Click="SyncClick" />
              <Separator />
              <MenuItem Header="ブランチをMerge..." Click="MergeBranchClick" />
              <MenuItem Header="ブランチをRebase..." Click="RebaseBranchClick" />
              <Separator />
              <MenuItem Header="GitHubへRemoteを発行..." Click="PublishRemoteClick" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Padding="12,32" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FFFFFF">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasRepository}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel VerticalAlignment="Top">
        <TextBlock Text="Git リポジトリがありません" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Git リポジトリを含むフォルダーを開くと、ここで変更を管理できます。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
        <Button Content="フォルダーを開く" Click="ChooseRepositoryClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" HorizontalContentAlignment="Center" />
        <TextBlock Text="{Binding SelectedDirectory}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,10" />
        <Button Content="Git リポジトリを初期化" Click="InitializeRepositoryClick" IsEnabled="{Binding CanInitializeRepository}" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasRepository}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1.1*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1.1*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="⑂" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,0,7,0" />
        <TextBlock Grid.Column="1" Text="{Binding Branch}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding RepositoryState}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Grid.Row="1" Text="{Binding RepositoryRoot}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,7" />

      <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FAFAFA" Padding="6" Margin="0,0,0,7">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasRemote}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding RemoteSummary}" FontSize="10" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="↑ " Foreground="{StaticResource MutedBrush}" FontSize="10" />
              <TextBlock Text="{Binding Ahead}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
              <TextBlock Text="  ↓ " Foreground="{StaticResource MutedBrush}" FontSize="10" />
              <TextBlock Text="{Binding Behind}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="Fetch" ToolTip="Remoteの参照を更新" Click="FetchClick" Style="{StaticResource ActionButtonStyle}" />
          <Button Grid.Column="2" Content="Pull" ToolTip="Remoteの変更を取り込む" Click="PullClick" Style="{StaticResource ActionButtonStyle}" />
          <Button Grid.Column="3" Content="Push" ToolTip="ローカルコミットを送信" Click="PushClick" Style="{StaticResource ActionButtonStyle}" />
          <Button Grid.Column="4" Content="同期" ToolTip="PullしてからPush" Click="SyncClick" Style="{StaticResource ActionButtonStyle}" Margin="0" />
        </Grid>
      </Border>

      <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FFFFFF" Margin="0,0,0,6">
        <TextBox x:Name="CommitMessage" Height="52" BorderThickness="0" Padding="7" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="{StaticResource ForegroundBrush}" ToolTip="コミットメッセージ" />
      </Border>
      <Grid Grid.Row="4" Margin="0,0,0,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Content="{Binding PrimaryActionLabel}" Click="PrimaryActionClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" HorizontalContentAlignment="Center" Margin="0,0,2,0" />
        <Button Grid.Column="1" Width="31" Content="▼" ToolTip="コミット操作" Click="OpenCommitMenuClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Padding="3" Margin="0">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPublishRemotePrimaryAction}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="コミット" Click="CommitClick" />
              <MenuItem Header="コミット（修正）" Click="AmendCommitClick" />
              <Separator />
              <MenuItem Header="コミットしてPush" Click="CommitAndPushClick" />
              <MenuItem Header="コミットして同期" Click="CommitAndSyncClick" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
      </Grid>

      <Border Grid.Row="5" BorderBrush="#E6A700" BorderThickness="1" Background="#FFF9E6" Padding="8" Margin="0,0,0,8">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasActiveOperation}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Conflicts.Count}" Foreground="{StaticResource MutedBrush}" />
          </Grid>
          <TextBlock Text="各ファイルで採用する内容を選ぶと、自動的にステージされます。" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
          <ListBox ItemsSource="{Binding Conflicts}" MaxHeight="130" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ローカル" Tag="{Binding}" ToolTip="ローカルの内容を採用" Click="KeepLocalConflictClick" Style="{StaticResource ActionButtonStyle}" />
                    <Button Content="Remote" Tag="{Binding}" ToolTip="Remoteから受信した内容を採用" Click="KeepIncomingConflictClick" Style="{StaticResource ActionButtonStyle}" Margin="0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
            <Button Content="中止" Click="AbortOperationClick" Style="{StaticResource ActionButtonStyle}" />
            <Button Content="続行" Click="ContinueOperationClick" Margin="0">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                  <Setter Property="IsEnabled" Value="True" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                      <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="8" Margin="0,2,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="変更" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding Changes.Count}" Foreground="{StaticResource MutedBrush}" />
      </Grid>
      <ListBox Grid.Row="9" x:Name="ChangesList" ItemsSource="{Binding Changes}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2" VerticalAlignment="Top">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="↶" Tag="{Binding}" ToolTip="変更を破棄" Click="DiscardClick" Style="{StaticResource ActionButtonStyle}" />
                <Button Content="+" Tag="{Binding}" ToolTip="ステージ" Click="StageClick" Style="{StaticResource ActionButtonStyle}" Margin="0" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    <Grid Grid.Row="6" Margin="0,2,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="ステージ済みの変更" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="{Binding Staged.Count}" Foreground="{StaticResource MutedBrush}" />
      </Grid>
    <ListBox Grid.Row="7" x:Name="StagedList" ItemsSource="{Binding Staged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" SelectionChanged="FileSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding StatusLabel}" Foreground="#3A8F3A" FontFamily="Consolas" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DirectoryName}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="2" Content="−" Tag="{Binding}" ToolTip="ステージから外す" Click="UnstageClick" Style="{StaticResource ActionButtonStyle}" Margin="4,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="10" Margin="0,8,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="グラフ" FontWeight="SemiBold" />
        <TextBlock Grid.Column="1" Text="履歴" Foreground="{StaticResource MutedBrush}" />
      </Grid>
      <ListBox Grid.Row="11" ItemsSource="{Binding History}" ItemContainerStyle="{StaticResource HistoryItemStyle}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CommitSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DisplayText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="7,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <TextBlock Text="{Binding Author}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="10" />
                <TextBlock Text="{Binding Date}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
