<Window x:Class="YmmSourceControl.Plugin.DiscardChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="変更を破棄"
        Width="560"
        Height="205"
        MinWidth="500"
        Background="#FFFFFF"
        Foreground="#333333"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#B42318" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="変更を破棄しますか？" FontSize="15" FontWeight="SemiBold" />
    <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" Click="CancelClick" />
      <Button Content="変更を破棄" IsDefault="True" Click="DiscardClick" Background="{StaticResource DangerBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource DangerBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
