<Window x:Class="YmmSourceControl.Plugin.ConflictResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="競合を手動で解決"
        Width="900"
        Height="650"
        MinWidth="620"
        MinHeight="420"
        Background="#FFFFFF"
        Foreground="#333333"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="手動で競合を解決" FontSize="16" FontWeight="SemiBold" />
    <TextBlock x:Name="PathText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
    <TextBlock Grid.Row="2" Text="下の文章を編集し、競合マーカー（&lt;&lt;&lt;&lt;&lt;&lt;&lt;・=======・&gt;&gt;&gt;&gt;&gt;&gt;&gt;）を削除して、最終的に残したい内容だけにしてください。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,8" />
    <TextBox Grid.Row="3"
             x:Name="ContentEditor"
             AcceptsReturn="True"
             FontFamily="Consolas"
             FontSize="12"
             TextWrapping="NoWrap"
             HorizontalScrollBarVisibility="Auto"
             VerticalScrollBarVisibility="Auto"
             Background="#FAFAFA"
             Foreground="#333333"
             BorderBrush="{StaticResource BorderBrush}"
             Padding="9" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="キャンセル" IsCancel="True" />
      <Button Content="解決済みとして登録" Click="ResolveClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
