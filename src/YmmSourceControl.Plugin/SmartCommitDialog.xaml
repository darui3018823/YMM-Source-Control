<Window x:Class="YmmSourceControl.Plugin.SmartCommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ステージしてコミット"
        Width="620"
        Height="220"
        MinWidth="560"
        Background="#FFFFFF"
        Foreground="#333333"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="ステージ済みの変更がありません" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="変更中のファイルをすべてステージして、コミットしますか？" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" Click="CancelClick" />
      <Button Content="今後は聞かない" Click="NeverClick" />
      <Button Content="常にステージしてコミット" Click="AlwaysClick" />
      <Button Content="ステージしてコミット" IsDefault="True" Click="StageAndCommitClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
