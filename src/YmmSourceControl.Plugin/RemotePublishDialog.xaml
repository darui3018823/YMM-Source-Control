<Window x:Class="YmmSourceControl.Plugin.RemotePublishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHubへRemoteを発行"
        Width="600"
        Height="390"
        MinWidth="540"
        Background="#FFFFFF"
        Foreground="#333333"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="GitHubリポジトリを作成して接続します" FontSize="15" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="認証にはインストール済みのgh CLIを使用します。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14" />

    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="115" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <TextBlock Text="リポジトリ名" VerticalAlignment="Center" />
      <TextBox x:Name="RepositoryNameText" Grid.Column="1" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="115" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Remote名" VerticalAlignment="Center" />
      <TextBox x:Name="RemoteNameText" Grid.Column="1" Text="origin" />
    </Grid>

    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="115" />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <TextBlock Text="説明（任意）" VerticalAlignment="Top" Margin="0,6,0,0" />
      <TextBox x:Name="DescriptionText" Grid.Column="1" Height="58" AcceptsReturn="True" TextWrapping="Wrap" />
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="公開範囲" Width="115" VerticalAlignment="Center" />
      <RadioButton x:Name="PrivateOption" Content="Private" IsChecked="True" GroupName="Visibility" Margin="0,0,18,0" />
      <RadioButton x:Name="PublicOption" Content="Public" GroupName="Visibility" Margin="0,0,18,0" />
      <RadioButton x:Name="InternalOption" Content="Internal" GroupName="Visibility" />
    </StackPanel>

    <StackPanel Grid.Row="6">
      <CheckBox x:Name="PushOption" Content="作成後に現在のブランチをPushする" IsChecked="True" />
      <TextBlock x:Name="ValidationText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" />
      <Button Content="発行" IsDefault="True" Click="PublishClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
