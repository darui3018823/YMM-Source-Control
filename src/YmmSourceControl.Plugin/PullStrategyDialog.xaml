<Window x:Class="YmmSourceControl.Plugin.PullStrategyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remoteの変更を取り込む"
        Width="620"
        MinWidth="560"
        SizeToContent="Height"
        Background="#FFFFFF"
        Foreground="#333333"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Remoteの変更をどう取り込みますか？" FontSize="15" FontWeight="SemiBold" />
    <TextBlock x:Name="ReasonText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />

    <StackPanel Grid.Row="2">
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
        <RadioButton x:Name="MergeOption" GroupName="PullStrategy" IsChecked="True">
          <StackPanel>
            <TextBlock Text="Merge" FontWeight="SemiBold" />
            <TextBlock Text="Remoteの変更を現在のブランチへMergeします。既存の履歴を維持します。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </RadioButton>
      </Border>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10">
        <RadioButton x:Name="RebaseOption" GroupName="PullStrategy">
          <StackPanel>
            <TextBlock Text="Rebase" FontWeight="SemiBold" />
            <TextBlock Text="ローカルコミットをRemoteの最新履歴上へ載せ直します。未Pushの履歴が整理されます。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
          </StackPanel>
        </RadioButton>
      </Border>
    </StackPanel>

    <CheckBox x:Name="RememberChoice" Grid.Row="3" Content="この選択を保存し、次回から確認しない" Margin="0,13,0,14" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="キャンセル" IsCancel="True" />
      <Button Content="取り込む" IsDefault="True" Click="AcceptClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
