<Window x:Class="YmmSourceControl.Plugin.FileDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="変更内容"
        Width="820"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        Background="#FFFFFF"
        Foreground="#333333"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="230" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="FileNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,12">
      <TextBlock x:Name="PathText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" />
      <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="このファイルで変わったこと" FontWeight="SemiBold" />
      <TextBlock x:Name="ChangeCountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" />
    </Grid>

    <ListBox Grid.Row="3" x:Name="SummaryList" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,2,0,5">
            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource ForegroundBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Expander Grid.Row="4" Header="詳細なGit diffを表示（開発者向け）" Margin="0,10,0,0" IsExpanded="False">
      <TextBox x:Name="DiffText" Height="195" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA" Foreground="#333333" BorderBrush="{StaticResource BorderBrush}" Padding="9" />
    </Expander>
  </Grid>
</Window>
