<Window x:Class="YmmSourceControl.Plugin.CommitDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="コミットの変更"
        Width="820"
        Height="620"
        MinWidth="560"
        MinHeight="420"
        Background="#FFFFFF"
        Foreground="#333333"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CB0" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F2F6FA" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="230" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SubjectText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,12">
      <TextBlock x:Name="HashText" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
      <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" />
      <TextBlock x:Name="AuthorText" Foreground="{StaticResource MutedBrush}" />
      <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" />
      <TextBlock x:Name="DateText" Foreground="{StaticResource MutedBrush}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="105" />
      </Grid.RowDefinitions>
      <TextBlock Text="変更したファイル" FontWeight="SemiBold" Margin="0,0,0,5" />
      <ListBox Grid.Row="1" x:Name="ChangedFilesList" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="このコミットで変わったこと" FontWeight="SemiBold" />
      <TextBlock x:Name="FileCountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" />
    </Grid>

    <ListBox Grid.Row="4" x:Name="SummaryList" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="0,2,0,5">
            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource ForegroundBrush}" Margin="0,2,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Expander Grid.Row="5" Header="詳細なGit diffを表示（開発者向け）" Margin="0,10,0,0" IsExpanded="False">
      <TextBox x:Name="DiffText" Height="195" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA" Foreground="#333333" BorderBrush="{StaticResource BorderBrush}" Padding="9" />
    </Expander>
  </Grid>
</Window>
