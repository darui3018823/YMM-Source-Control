<Window x:Class="YmmSourceControl.Plugin.BranchOperationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="230"
        MinWidth="500"
        Background="#FFFFFF"
        Foreground="#333333"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7D7D7" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2F75B5" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" />
    <TextBlock x:Name="DescriptionText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
    <ComboBox x:Name="BranchSelector" Grid.Row="2" Height="28" IsEditable="True" VerticalContentAlignment="Center" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="キャンセル" IsCancel="True" />
      <Button x:Name="AcceptButton" IsDefault="True" Click="AcceptClick" Background="{StaticResource AccentBackgroundBrush}" Foreground="White" BorderBrush="{StaticResource AccentBackgroundBrush}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
